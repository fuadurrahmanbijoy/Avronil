<Window x:Class="Anjana.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anjana Setup" Width="640" Height="400" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="#14161B" Foreground="#ECEEF2"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#5A97F8"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA0AC"/>
        <SolidColorBrush x:Key="Field" Color="#1C1F26"/>
        <SolidColorBrush x:Key="Stroke" Color="#2A2E36"/>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="30,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#ECEEF2"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1F232B" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#282D37"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#ECEEF2"/>
            <Setter Property="CaretBrush" Value="#ECEEF2"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource Field}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ECEEF2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="#5A606C" Background="Transparent">
                                <TextBlock x:Name="Tick" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="10"
                                           Foreground="White" HorizontalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="6">
                            <Border CornerRadius="3" Background="#262A33"/>
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                        Background="{StaticResource Accent}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Brand panel -->
            <Border x:Name="BrandPanel" Background="#101216">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/anjana.png" Width="76" Height="76"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Anjana" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        <TextBlock Text="Built with love and care" Foreground="{StaticResource Muted}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Built by Bijoy" Foreground="#6B7280" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,0,0,22"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Border x:Name="DragStrip" Height="36" VerticalAlignment="Top" Background="Transparent"/>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click"/>

                <!-- Page 1: options -->
                <Grid x:Name="PageOptions" Margin="34,44,34,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Install Anjana" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="Live network speed, right in your taskbar." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>

                    <StackPanel Grid.Row="2" Margin="0,26,0,0">
                        <TextBlock Text="Install location" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,22,0,0">
                        <CheckBox x:Name="StartupCheck" Content="Start Anjana when Windows starts" IsChecked="True" Margin="0,0,0,12"/>
                        <CheckBox x:Name="StartMenuCheck" Content="Add to Start menu" IsChecked="True" Margin="0,0,0,12"/>
                        <CheckBox x:Name="DesktopCheck" Content="Create a desktop shortcut"/>
                    </StackPanel>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Note" Text="Installs for your account. No admin rights needed."
                                   Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                        <Button Grid.Column="1" Content="Install" Style="{StaticResource PrimaryButton}" Click="Install_Click"/>
                    </Grid>
                </Grid>

                <!-- Page 2: progress -->
                <Grid x:Name="PageProgress" Margin="34,44,34,28" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Installing…" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Text="Preparing…" Foreground="{StaticResource Muted}" Margin="0,4,0,28"/>
                        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0"/>
                        <TextBlock x:Name="PercentText" Text="0%" Foreground="{StaticResource Muted}" FontSize="12"
                                   HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Page 3: done / error -->
                <Grid x:Name="PageDone" Margin="34,44,34,28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <Border x:Name="DoneBadge" Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Left" Background="{StaticResource Accent}">
                            <TextBlock x:Name="DoneGlyph" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="20" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="DoneTitle" Text="Anjana is ready" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,0"/>
                        <TextBlock x:Name="DoneText" Text="Look for the speed readout beside your system tray."
                                   Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <CheckBox x:Name="LaunchCheck" Content="Launch Anjana now" IsChecked="True" Margin="0,24,0,0"/>
                    </StackPanel>
                    <Button Grid.Row="1" x:Name="FinishButton" Content="Finish" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Click="Finish_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
