<Window x:Class="Anjana.Views.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anjana" Width="106" Height="48" Left="-10000" Top="-10000"
        WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- 40 px hover plate centred in the 48 px taskbar, same geometry as Win11 taskbar buttons -->
    <Border x:Name="Root" Margin="0,4" CornerRadius="4"
            MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseMove="Root_MouseMove"
            MouseLeftButtonUp="Root_MouseLeftButtonUp" MouseRightButtonUp="Root_MouseRightButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#01000000"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid x:Name="ContentGrid" Margin="8,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" MinWidth="30"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="16"/>
                <RowDefinition Height="16"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Glyph}" Text="&#xE74A;" Foreground="{DynamicResource UpBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UpValue" Style="{StaticResource Value}" Text="0"/>
            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="UpUnit" Style="{StaticResource Unit}" Text="KB/s"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Glyph}" Text="&#xE74B;" Foreground="{DynamicResource DownBrush}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DownValue" Style="{StaticResource Value}" Text="0"/>
            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="DownUnit" Style="{StaticResource Unit}" Text="KB/s"/>
        </Grid>
    </Border>
</Window>
