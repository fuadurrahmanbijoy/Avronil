<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Anjana-Setup</AssemblyName>
    <RootNamespace>Anjana.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\anjana.ico</ApplicationIcon>
    <Product>Anjana</Product>
    <Company>Bijoy</Company>
    <Description>Anjana Setup - Built with love and care</Description>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\AppInfo.cs" Link="AppInfo.cs" />
    <Resource Include="..\assets\anjana.png" Link="Assets\anjana.png" />
    <!-- Populated by build.ps1 (published self-contained Anjana.exe) -->
    <EmbeddedResource Include="payload\Anjana.exe" LogicalName="payload.exe" />
  </ItemGroup>
</Project>
